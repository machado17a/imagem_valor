{
  "manifest_version": 3,
  "name": "Extrator de Matérias - WhatsApp",
  "version": "1.0",
  "description": "Extrai o conteúdo de matérias jornalísticas e formata para compartilhar no WhatsApp.",
  "permissions": [
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extrator de Matérias"
  },
  "web_accessible_resources": [
    {
      "resources": ["Readability.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
